{
  "expo": {
    "name": "BrainLeap MVP",
    "slug": "brainleap-mvp",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/applogo.png",
    "splash": {
      "image": "./assets/applogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366f1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "url": "https://u.expo.dev/brainleap-mvp"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brainleap.mvp",
      "icon": "./assets/applogo.png"
    },
    "android": {
      "icon": "./assets/applogo.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/applogo.png",
        "backgroundColor": "#6366f1"
      },
      "package": "com.brainleap.mvp"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/applogo.png"
    },
    "extra": {
      "eas": {
      }
    }
  }
}
